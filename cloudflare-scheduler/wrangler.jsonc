{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webwatch-monitor-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "CRON_URL": "https://webwatch-gamma.vercel.app/api/cron"
  }
}
