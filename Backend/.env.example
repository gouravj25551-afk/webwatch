DATABASE_URL="postgresql://USERNAME@localhost:5432/webwatch?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
COOKIE_NAME="webwatch_token"
CHECK_INTERVAL_MS=30000
MAX_MONITORS_PER_USER=10
RESEND_API_KEY=""
ALERT_FROM="WebWatch <alerts@yourdomain.com>"
CRON_SECRET="replace-with-another-long-random-secret"

# Dodo Payments (SaaS Monetization)
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_MODE="test_mode" # test_mode or live_mode
DODO_PAYMENTS_PRODUCT_ID="" # Optional: Dodo product ID for $1 site monitor
BILLING_ENABLED="false" # Keep false for the free beta
