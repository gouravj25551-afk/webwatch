generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
  PAUSED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  sessionVersion    Int       @default(0)
  paidMonitorsCount Int       @default(0)
  monitors          Monitor[]
  payments          Payment[]
  authTokens        AuthToken[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dodoPaymentId String?  @unique
  dodoSessionId String?  @unique
  amount        Int      @default(100)
  currency      String   @default("USD")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model Monitor {
  id                  String        @id @default(uuid())
  name                String
  url                 String
  alertEmail          String
  intervalMinutes     Int           @default(5)
  enabled             Boolean       @default(true)
  status              MonitorStatus @default(UNKNOWN)
  lastCheckedAt       DateTime?
  lastStatusCode      Int?
  lastResponseTimeMs  Int?
  lastError           String?
  consecutiveFailures Int           @default(0)
  checkLeaseUntil     DateTime?
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks              Check[]
  incidents           Incident[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([enabled, lastCheckedAt])
  @@index([checkLeaseUntil])
}

model Check {
  id             String   @id @default(uuid())
  monitorId      String
  monitor        Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  isUp           Boolean
  statusCode     Int?
  responseTimeMs Int
  error          String?
  attempts       Int      @default(1)
  checkedAt      DateTime @default(now())

  @@index([monitorId, checkedAt])
  @@index([checkedAt])
}

model Incident {
  id            String         @id @default(uuid())
  monitorId     String
  monitor       Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startedAt     DateTime       @default(now())
  resolvedAt    DateTime?
  startReason   String?
  notifications Notification[]

  @@index([monitorId, startedAt])
  @@index([monitorId, resolvedAt])
  @@index([resolvedAt])
}

model Notification {
  id                 String             @id @default(uuid())
  incidentId         String
  incident           Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type               String
  recipient          String
  sender             String
  subject            String
  html               String
  status             NotificationStatus @default(PENDING)
  attempts           Int                @default(0)
  nextAttemptAt      DateTime           @default(now())
  deliveryLeaseUntil DateTime?
  lastError          String?
  providerMessageId  String?
  sentAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([incidentId, type])
  @@index([status, nextAttemptAt])
  @@index([deliveryLeaseUntil])
  @@index([createdAt])
}

model MaintenanceJob {
  id         String    @id
  lastRunAt  DateTime?
  leaseUntil DateTime?
  updatedAt  DateTime  @updatedAt
}
